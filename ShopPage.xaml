<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SilaghiDavidLab7.ShopPage"
             Title="Shop Details">
    <StackLayout Margin="20" Spacing="15">
        <Editor Placeholder="Enter shop name" Text="{Binding ShopName}" HeightRequest="60" />
        <Editor Placeholder="Enter shop address" Text="{Binding Adress}" HeightRequest="60" />
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" ColumnSpacing="10">
            <Button Text="Save Shop" Clicked="OnSaveButtonClicked" />
            <Button Text="Show on Map" Clicked="OnShowMapButtonClicked" />
            <Button Text="Delete" BackgroundColor="#D32F2F" TextColor="White" Clicked="OnDeleteButtonClicked" />
        </Grid>
    </StackLayout>
</ContentPage>
